# Maintainer: alon3wolfus <260382617+alon3wolfus@users.noreply.github.com>

pkgname=quiver-git
_pkgname=quiver
pkgver=0.1.0
pkgrel=1
pkgdesc='PowerToys-style tools for Hyprland: launcher, window zones, colour picker, OCR, bulk rename and more (latest git)'
arch=('x86_64' 'aarch64')
url='https://github.com/alon3wolfus/quiver'
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'gtk4' 'gtk4-layer-shell' 'hyprland' 'hyprpicker' 'grim' 'slurp' 'wl-clipboard' 'tesseract')
makedepends=('cargo' 'git')
optdepends=(
  'tesseract-data-eng: English text recognition for the text extractor'
  'libnotify: notifications after picking a colour or copying text'
  'foot: terminal for running launcher commands with Shift+Enter'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  # v0.1.0-3-gabc1234 → 0.1.0.r3.gabc1234; before the first tag, r42.abc1234
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/quiver "$pkgdir/usr/bin/quiver"
  install -Dm644 packaging/quiver.desktop "$pkgdir/usr/share/applications/quiver.desktop"
  install -Dm644 packaging/quiver.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/quiver.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
