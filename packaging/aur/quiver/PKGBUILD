# Maintainer: alon3wolfus <260382617+alon3wolfus@users.noreply.github.com>

pkgname=quiver
pkgver=0.2.0
pkgrel=1
pkgdesc='PowerToys-style tools for Hyprland: launcher, window zones, colour picker, OCR, bulk rename and more'
arch=('x86_64' 'aarch64')
url='https://github.com/alon3wolfus/quiver'
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'gtk4' 'gtk4-layer-shell' 'hyprland' 'hyprpicker' 'grim' 'slurp' 'wl-clipboard' 'tesseract')
makedepends=('cargo')
optdepends=(
  'tesseract-data-eng: English text recognition for the text extractor'
  'libnotify: notifications after picking a colour or copying text'
  'foot: terminal for running launcher commands with Shift+Enter'
  'plocate: whole-system file search ($$ in the launcher)'
  'gpu-screen-recorder: screen recording (quiver record)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Run `updpkgsums` after the v$pkgver tag is pushed to fill this in.
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/quiver "$pkgdir/usr/bin/quiver"
  install -Dm644 packaging/quiver.desktop "$pkgdir/usr/share/applications/quiver.desktop"
  install -Dm644 packaging/quiver.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/quiver.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
